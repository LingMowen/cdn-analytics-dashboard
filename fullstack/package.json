{
  "name": "unified-monitor-fullstack",
  "version": "1.0.0",
  "description": "Unified Monitor - Fullstack Version",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch src/backend/index.js",
    "dev:frontend": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "start": "node src/backend/index.js",
    "start:cn": "node src/backend/index.js",
    "start:en": "EN=true node src/backend/index.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "axios": "^1.7.2",
    "js-yaml": "^4.1.0",
    "dotenv": "^17.2.3",
    "tencentcloud-sdk-nodejs-teo": "^4.1.154",
    "tencentcloud-sdk-nodejs-common": "^4.1.122",
    "node-cache": "^5.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "echarts": "^5.4.3",
    "echarts-for-react": "^3.0.2",
    "i18next": "^23.7.0",
    "react-i18next": "^13.5.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.46.0",
    "vite": "^5.1.0",
    "concurrently": "^8.2.2"
  }
}
