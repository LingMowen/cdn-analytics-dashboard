# 服务配置
PORT=4000
NODE_ENV=development

# 语言设置 (true=英文, false=中文)
EN=false

# Cloudflare API 配置
# CLOUDFLARE_API_TOKEN=your_api_token
# CLOUDFLARE_API_EMAIL=your_email@example.com

# EdgeOne API 配置
# TEO_SECRET_ID=your_secret_id
# TEO_SECRET_KEY=your_secret_key

# 阿里云ESA配置
# ALIYUN_ESA_ACCESS_KEY_ID=your_access_key_id
# ALIYUN_ESA_ACCESS_KEY_SECRET=your_access_key_secret
